# Model calls. Required for real extraction and packet generation.
OPENAI_API_KEY=

# Postgres with the pgvector extension (Neon or Supabase).
DATABASE_URL=

# Absolute URL, used for OG tags. Optional: if this is unset, empty or
# malformed, lib/app-url.ts falls back to VERCEL_PROJECT_PRODUCTION_URL, then
# VERCEL_URL (both set automatically by Vercel), then http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single password gating /ops.
OPS_PASSWORD=

# Global daily spend ceiling in USD.
DAILY_SPEND_CEILING_USD=15

# Optional model overrides. Defaults live in lib/ai/provider.ts.
# OPENAI_VISION_MODEL=
# OPENAI_PACKET_MODEL=
# OPENAI_CLASSIFY_MODEL=
# OPENAI_RECAP_MODEL=
# OPENAI_EMBEDDING_MODEL=

# Signs the session cookie. Without it the app falls back to a fixed
# development value and sessions are forgeable, which /ops/doctor says loudly.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Magic-link email, via Resend. RESEND_FROM must be an address on a domain you
# have verified with Resend. Without both, sign-in links are written to the
# server log instead of being delivered, and never shown in the browser.
RESEND_API_KEY=
RESEND_FROM=

# Voice for the audio primer.
OPENAI_TTS_VOICE=nova
