// ParentPilot data model.
//
// Two invariants are enforced here, not just in application code:
//   1. There is no Child account. `Child` is a profile owned by a Parent:
//      no email, no password, no session, no login path of any kind.
//   2. `Move` has no transcript column. Live Mode derives a label and a
//      timestamp and discards the words. Adding a transcript column here
//      would silently break the privacy promise made on /privacy.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model Parent {
  id              String    @id @default(cuid())
  email           String?   @unique
  emailVerifiedAt DateTime?
  register        Register  @default(STANDARD)
  anxietyBand     Int       @default(2) // 1 loved it .. 4 miserable
  language        String    @default("en")
  createdAt       DateTime  @default(now())
  children        Child[]
  threads         Thread[]
}

/// A single-use sign-in link.
///
/// The raw token is emailed and never stored: only its SHA-256 hash is kept,
/// so a leaked database does not hand over live sign-in links. Rows are
/// single-use (`usedAt`) and short-lived (`expiresAt`).
model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// A continuous conversation about one child's homework.
///
/// The thread is the product surface now. A parent photographs problem one,
/// works through it, then photographs problem two in the same thread, and the
/// child, register and language carry across without being re-asked.
model Thread {
  id        String    @id @default(cuid())
  parentId  String
  childId   String?
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child     Child?    @relation(fields: [childId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([parentId, updatedAt])
}

/// One turn in a thread.
///
/// An ASSISTANT turn is a card rather than prose, and a card that concerns a
/// problem points at it by id. The packet is never duplicated here: `problemId`
/// is the join, so a re-generated packet is reflected everywhere at once.
model Message {
  id        String      @id @default(cuid())
  threadId  String
  role      MessageRole
  kind      MessageKind
  body      String?
  payload   Json?
  problemId String?
  createdAt DateTime    @default(now())
  thread    Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Child {
  id         String   @id @default(cuid())
  parentId   String
  firstName  String? // optional, used only in scripts
  /// Null when nobody has said. The pipeline infers it from the standard
  /// the problem retrieves against rather than assuming a year group, so a
  /// parent who has not finished setup still gets their own worksheet read.
  grade      Int? // 0 = K, 1..8, or null for unknown
  curriculum String   @default("CCSS")

  /// The language the worksheet is written in, which is often not the
  /// language the parent wants to be spoken to in. A mother who reads Arabic
  /// comfortably and whose daughter is taught in English needs the coaching
  /// in Arabic and the vocabulary in English, in the same sentence. Null
  /// means it is the same as the parent's language, which is the ordinary
  /// case and should not have to be stated.
  schoolLanguage String?

  subjects   String[]
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  assignments Assignment[]
  sessions    Session[]
  threads     Thread[]

  @@index([parentId])
}

model Assignment {
  id         String    @id @default(cuid())
  childId    String
  source     Source // PHOTO | PDF | VOICE | TEXT
  capturedAt DateTime  @default(now())
  pageUrls   String[]
  problems   Problem[]
  child      Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model Problem {
  id              String     @id @default(cuid())
  assignmentId    String
  index           Int
  printedText     String
  childWorkText   String?
  childAnswer     String?
  ocrConfidence   Float?
  standardCode    String?
  expectedMethod  String?
  verified        Boolean    @default(false)
  computedAnswer  String?
  misconceptionId String?
  status          Status     @default(OPEN) // OPEN | SOLVED | PARKED
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  packets         Packet[]

  @@index([assignmentId])
}

model Packet {
  id              String   @id @default(cuid())
  problemId       String
  register        Register
  language        String
  cacheKey        String   @unique // standardCode:register:language
  primer          String
  methodMatchJson Json
  hintLadderJson  Json // string[5]
  scriptsJson     Json // { avoid, use }[]
  lockedAnswer    String
  isomorphsJson   Json // string[3]
  createdAt       DateTime @default(now())
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Session {
  id             String    @id @default(cuid())
  childId        String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  mode           Mode // COACH | LIVE
  autonomyScore  Float?
  moveCountsJson Json?
  parked         Boolean   @default(false)

  /// Read-only share link for a teacher. Random, revocable by setting it back
  /// to null, and expiring. What the link renders is derived from `moves`,
  /// which hold a label and a timestamp and no words, so there is no path from
  /// a share token to anything that was said.
  shareToken     String?   @unique
  shareExpiresAt DateTime?

  moves Move[]
  cards Card[]
  child Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model Move {
  id         String    @id @default(cuid())
  sessionId  String
  tOffset    Int // seconds from session start
  label      MoveLabel
  confidence Float
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // NOTE: no transcript column. Never store what was said.

  @@index([sessionId])
}

model Card {
  id           String    @id @default(cuid())
  sessionId    String
  tOffset      Int
  triggerLabel MoveLabel
  text         String
  dismissed    Boolean   @default(false)
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Misconception {
  id             String  @id
  topic          String
  standardCode   String
  signature      String // what the wrong work looks like
  plainName      String // parent-facing, non-clinical
  repairQuestion String
  visualSvg      String?

  @@index([standardCode])
}

model Standard {
  id              String   @id
  code            String   @unique // e.g. CCSS.MATH.4.NF.B.3

  /// Which curriculum this belongs to: CCSS, ENC (England National
  /// Curriculum), CBSE. Retrieval is scoped to the child's, because a
  /// parent in Delhi being told what the Common Core expects is worse than
  /// being told nothing: it is confidently the wrong school.
  curriculum      String   @default("CCSS")

  grade           Int
  plainLanguage   String
  expectedMethods String[]
  parentMethod    String

  /// Declared as Unsupported so `prisma migrate diff` sees it and stops
  /// proposing to drop it on every new migration. Prisma Client cannot select
  /// an Unsupported field, which is fine: it is read and written exclusively
  /// through $queryRaw in lib/standards.ts. The HNSW cosine index is still
  /// raw SQL, since the operator class has no Prisma syntax.
  embedding Unsupported("vector(1536)")?

  @@index([grade])
  @@index([curriculum, grade])
}

model RateBucket {
  id       String   @id @default(cuid())
  key      String // ip:scope
  windowAt DateTime
  count    Int      @default(0)

  @@unique([key, windowAt])
}

/// Cached text-to-speech of a packet primer.
///
/// Keyed by the same cache key as the packet it reads, so a primer is spoken
/// once per standard, register and language rather than once per listen. The
/// bytes live here rather than in object storage because the product has no
/// bucket and a two minute primer is a few hundred kilobytes.
model AudioPrimer {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  voice     String
  mimeType  String   @default("audio/mpeg")
  bytes     Bytes
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
}

model SpendLog {
  id  String @id @default(cuid())
  day String @unique // YYYY-MM-DD
  usd Float  @default(0)
}

model FailureLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  scope     String
  message   String
  createdAt DateTime @default(now())

  @@index([at])
}

enum MessageRole {
  PARENT
  ASSISTANT
}

enum MessageKind {
  TEXT
  WORKSHEET
  ASK
  MISCONCEPTION
  METHOD_MATCH
  ANSWER
  TEACHING
  LIVE_SUMMARY
  PARK_IT
  LIVE_COACH
  EXPLAINER
  WORKED_EXAMPLE
  STRATEGY
}

enum Register {
  PLAIN
  STANDARD
  TECHNICAL
}

enum Source {
  PHOTO
  PDF
  VOICE
  TEXT
}

enum Status {
  OPEN
  SOLVED
  PARKED
}

enum Mode {
  COACH
  LIVE
}

enum MoveLabel {
  GIVES_ANSWER
  PROBING_QUESTION
  GENERIC_PRAISE
  SPECIFIC_PRAISE
  CRITICISM
  TAKES_OVER
  PRODUCTIVE_WAIT
  ANXIETY_STATEMENT
  ESCALATION
  NEUTRAL
}
